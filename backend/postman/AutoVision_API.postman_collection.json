{
	"info": {
		"_postman_id": "autovision-collection-001",
		"name": "AutoVision Rent API",
		"description": "Complete API test collection for AutoVision Rent — a vehicle rental management system with AI-powered inspections.\n\n## Quick Start\n1. Import both this collection AND the `AutoVision_Environment` environment.\n2. Select the **AutoVision Local** environment.\n3. Run **\"01 — Register User\"** → **\"02 — Login User\"** (token auto-saves).\n4. Run **\"03 — Register Admin\"** → **\"04 — Login Admin\"** (token auto-saves).\n5. Now all other requests will work using the saved tokens.\n\n## Authentication\n- `{{user_token}}` — populated automatically after user login\n- `{{admin_token}}` — populated automatically after admin login",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8000" }
	],
	"item": [
		{
			"name": "🔐 Auth & Users",
			"item": [
				{
					"name": "01 — Register User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser@example.com\",\n  \"full_name\": \"Test User\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/",
							"host": ["{{base_url}}"],
							"path": ["users", ""]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('User created successfully', function () {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('id');",
									"    pm.environment.set('user_id', json.id);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "02 — Login User",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/token",
							"host": ["{{base_url}}"],
							"path": ["users", "token"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Login successful — token saved', function () {",
									"    pm.response.to.have.status(200);",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('access_token');",
									"    pm.environment.set('user_token', json.access_token);",
									"});"
								]
							}
						}
					]
				},
